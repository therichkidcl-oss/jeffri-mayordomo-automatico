# ============================================================
# Jeffri — configuracion
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commitees `.env` al repo publico — contiene secretos.
# ============================================================

# --- Telegram (obligatorio) ----------------------------------
# Token del bot. Lo obtienes de @BotFather con /newbot.
# Formato: 123456789:ABCdef_GHI-jkl...
TELEGRAM_BOT_TOKEN=

# Tu user_id numerico de Telegram. Lo obtienes de @userinfobot con /start.
# Formato: 123456789 (10 digitos aprox.)
# Solo este user_id puede hablarle al bot — el resto se ignora.
TELEGRAM_ALLOWED_USER_ID=

# --- Claude Code Desktop (obligatorio) -----------------------
# Carpeta donde Claude Code Desktop guarda las transcripciones.
# Windows default: C:\Users\<TU_USUARIO>\.claude\projects
# Cambia <TU_USUARIO> por tu nombre de usuario de Windows.
CLAUDE_PROJECTS_DIR=C:\Users\TU_USUARIO\.claude\projects

# --- DeepSeek (recomendado) ----------------------------------
# API key para el enhancer que pule tus mensajes antes de pegarlos en Claude.
# Obtenla en https://platform.deepseek.com/api_keys (crear cuenta gratis).
# Sin esta key, el bot funciona pero manda los mensajes sin pulir.
DEEPSEEK_API_KEY=

# Modelo. "deepseek-flash" es el V4.1-Flash (ultimo alias oficial, barato y rapido).
# No lo cambies a menos que sepas que haces.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Groq (OPCIONAL, legacy) ---------------------------------
# Antes se usaba Groq para el enhancer. Desde la migracion a DeepSeek,
# estas keys quedan huerfanas — no se usan a menos que restaures el flow
# viejo editando src/bot.py. Puedes dejar esto vacio.
GROQ_API_KEYS=

# --- Flags de arranque ---------------------------------------
# Si no quieres Telegram y solo probar en local, pon TELEGRAM_ENABLED=false.
TELEGRAM_ENABLED=true

# Web UI local (http://localhost:8000) con el chat de Jeffri. Opcional.
# Si solo quieres Telegram, deja WEB_ENABLED=false.
WEB_ENABLED=false
WEB_BIND=127.0.0.1
WEB_PORT=8000
# Si expones el web UI a tu LAN (WEB_BIND=0.0.0.0), setea un token aqui
# para que no cualquiera pueda abrir tu bot. Pasa ?token=XXX en la URL.
WEB_AUTH_TOKEN=

# --- Interfaz de voz local (opcional, push-to-talk F9) -------
# Si quieres hablarle a Jeffri con una tecla (default F9), activa esto.
# Requiere los modelos de Piper (se descargan en voice_models/).
VOICE_ENABLED=false
VOICE_HOTKEY=f9

# Voz TTS de Piper. Si tienes otra en voice_models/, cambia el nombre.
# Las voces estan en https://rhasspy.github.io/piper-samples/
PIPER_VOICE=es_ES-davefx-medium
# length_scale > 1 habla mas lento (1.15 suena natural para mayordomo).
PIPER_LENGTH_SCALE=1.15

# Modelo de faster-whisper para transcripcion local: tiny/base/small/medium/large-v3.
# "small" es buen balance en CPU; "medium" mejor pero mas lento.
STT_MODEL_SIZE=small
