# Token del bot de Telegram (obtener de @BotFather)
TELEGRAM_BOT_TOKEN=

# Tu user_id de Telegram (obtener de @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# Ruta a la carpeta de proyectos de Claude (no cambiar)
CLAUDE_PROJECTS_DIR=C:\Users\Reimo\.claude\projects

# API keys de Groq (separadas por coma). Se rotan automaticamente si una falla.
# Si esta vacio, el bot funciona sin enhancer ni transcripcion de audio.
GROQ_API_KEYS=

# Servidor web local de la UI Batcave (localhost solo por seguridad).
WEB_BIND=127.0.0.1
WEB_PORT=8000
WEB_AUTH_TOKEN=

# Si TELEGRAM_ENABLED=false, el bot solo levanta la web Batcave en localhost:8000
# (sin polling de Telegram). En ese caso TELEGRAM_BOT_TOKEN y TELEGRAM_ALLOWED_USER_ID
# son opcionales.
TELEGRAM_ENABLED=true
